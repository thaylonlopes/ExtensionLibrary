<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <PackageId>TL.ClaimsPrincipalExtensionsLibrary</PackageId>
    <Title>ClaimsPrincipalExtensionsLibrary</Title>
    <Description>Strongly-typed ClaimsPrincipal extensions for ASP.NET Core: clean, safe access to user IDs, roles, emails, and authentication claims.</Description>
    <PackageTags>$(PackageTags);identity;claims;security;authorization;roles;jwt;aspnetcore</PackageTags>
  </PropertyGroup>
</Project>
