<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <PackageId>TL.DateTimeExtensionsLibrary</PackageId>
    <Title>DateTimeExtensionsLibrary</Title>
    <Description>Business-ready DateTime extensions for .NET: business day calculations, holiday evaluation, deadline handling, and fluent date arithmetic.</Description>
    <PackageTags>$(PackageTags);datetime;business-days;calendar;date;time;holiday;workdays</PackageTags>
  </PropertyGroup>
</Project>
