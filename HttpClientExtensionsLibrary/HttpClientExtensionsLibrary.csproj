<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <PackageId>TL.HttpClientExtensionsLibrary</PackageId>
    <Title>HttpClientExtensionsLibrary</Title>
    <Description>Resilient HttpClient extensions for .NET: safe request handling, built-in retry policies, JSON helpers, and robust API communication.</Description>
    <PackageTags>$(PackageTags);httpclient;http;resilience;retry;polly;rest;jwt;api</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>
</Project>
