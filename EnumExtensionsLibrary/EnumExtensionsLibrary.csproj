<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <PackageId>TL.EnumExtensionsLibrary</PackageId>
    <Title>EnumExtensionsLibrary</Title>
    <Description>Cached and safe enum extensions for .NET: fast attribute description lookup, key-value mappings, and reliable string parsing.</Description>
    <PackageTags>$(PackageTags);enum;descriptions;attributes;enum-values;parsing;reflection</PackageTags>
  </PropertyGroup>
</Project>
