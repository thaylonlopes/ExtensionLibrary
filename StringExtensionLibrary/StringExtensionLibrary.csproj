<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net5.0;net6.0;net8.0</TargetFrameworks>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <PackageId>TL.StringExtensionsLibrary</PackageId>
    <Description>Projeto de extensão para string</Description>
    <Description>Essential and ergonomic C# string utilities: safe truncation, span-friendly trimming, case-insensitive helpers, and clean parsing.</Description>
    <PackageTags>$(PackageTags);string;text;trim;truncate;formatting;parsing;manipulation</PackageTags>
    <Title>StringExtensionsLibrary</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
