<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <PackageId>TL.CollectionExtensionsLibrary</PackageId>
    <Title>CollectionExtensionsLibrary</Title>
    <Description>Practical collection extensions for .NET: efficient batching (ChunkBy), in-memory keyset pagination, safe filtering, and uniform shuffling.</Description>
    <PackageTags>$(PackageTags);collections;linq;keyset-pagination;batching;chunking;shuffle;hashset</PackageTags>
  </PropertyGroup>
</Project>
