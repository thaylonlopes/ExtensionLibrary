<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <PackageId>TL.NumericExtensionsLibrary</PackageId>
    <Title>NumericExtensionLibrary</Title>
    <Description>Lightweight numeric helpers for C#: value clamping, percentage calculations, and fluent math utilities for domain models and business logic.</Description>
    <PackageTags>$(PackageTags);numeric;math;calculate;digitsum;percentage;numbers</PackageTags>
  </PropertyGroup>
</Project>
