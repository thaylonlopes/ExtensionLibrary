<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <PackageId>TL.AssemblyExtensionLibrary</PackageId>
    <Title>AssemblyExtensionLibrary</Title>
    <Description>Lightweight assembly scanning extensions for .NET: type discovery, attribute filtering, and metadata helpers for clean dependency injection.</Description>
    <PackageTags>$(PackageTags);assembly;reflection;type-scanning;dependency-injection;metadata</PackageTags>
  </PropertyGroup>
</Project>
